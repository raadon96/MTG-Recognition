# Lists the settings you can change, with their defaults from
# src/mtg_recognition/settings.py. To change one, copy its line to .env.

# CPU threads for onnxruntime, OpenCV and numba during recognition;
# settings.py says why 4.
THREAD_COUNT=4

# The starting value of the web app's debug mode toggle, which shows what OCR read
# and how each candidate scored.
DEBUG_MODE=false
